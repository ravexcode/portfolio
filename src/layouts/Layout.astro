---
import "../styles/global.css";
import Seo from "../components/Seo.astro";

const link_class = "hover:underline hover:text-blue-400 duration-200";

const header_class = "font-bold md:w-full md:text-start";
const item_class =
  "hover:text-sky-500 hover:underline duration-200 cursor-pointer md:w-full md:text-start";
const { title, description, canonical, image, type, lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
    />
  </head>
  <body class="bg-neutral-950 text-zinc-50 grid grid-rows-[auto_1fr_auto] min-h-screen font-opensans">
    <header class="w-full flex items-center justify-between p-5 border-b border-neutral-800 animate-fade-in-down">
      <img src="/large.svg" alt="RavexCode presentation" class="h-6" />

      <nav class="hidden md:flex items-center justify-center gap-7 text-sm">
        <a href="/#about" class={link_class}>
          {" "}
          About{" "}
        </a>
        <a href="/#projects" class={link_class}>
          {" "}
          Projects{" "}
        </a>
        <a href="/#skills" class={link_class}>
          {" "}
          Skills{" "}
        </a>
      </nav>
    </header>

    <nav
      id="mobile-menu"
      class="hidden md:hidden flex-col items-stretch gap-1 px-5 pb-5 text-sm bg-neutral-950"
    >
      <a href="/#about" class={item_class}>
        About
      </a>
      <a href="/#projects" class={item_class}>
        Projects
      </a>
      <a href="/#skills" class={item_class}>
        Skills
      </a>
      <a href="/#hire" class={item_class}>
        Hire me
      </a>
      <a href="/pricing" class={item_class}>
        Pricing
      </a>
    </nav>

    <div class="w-full max-w-300 mx-auto">
      <slot />
    </div>
  </body>
</html>

<script>
  import Lenis from "lenis";

  const menuBtn = document.getElementById("menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener("click", () => {
      const open = mobileMenu.classList.toggle("flex");
      mobileMenu.classList.toggle("hidden");
      menuBtn.setAttribute("aria-expanded", String(open));
    });

    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.remove("flex");
        mobileMenu.classList.add("hidden");
        menuBtn.setAttribute("aria-expanded", "false");
      });
    });
  }

  const lenis = new Lenis({
    autoRaf: true,
    anchors: true,
  });

  document.querySelectorAll('a[href^="/#"]').forEach((link) => {
    link.addEventListener("click", (event) => {
      const id = link.getAttribute("href")?.split("#")[1];
      if (!id) return;
      const target = document.getElementById(id);
      if (!target) return;
      event.preventDefault();
      lenis.scrollTo(target, { duration: 1.2 });
      history.pushState(null, "", `#${id}`);
    });
  });
</script>
