---
import Layout from "../layouts/Layout.astro";
import Card from "../components/ui/card.astro";
import Project from "../components/ui/project.astro";

import { projects } from "../content/projects";
import { skills } from "../content/skills";

const langs = skills.filter((skill) => {
  if (skill.isFramework || skill.isApplication) return false;
  return skill;
});

const frameworks = skills.filter((skill) => {
  if (skill.isFramework) return skill;
  return false;
});

const apps = skills.filter((skill) => {
  if (skill.isApplication) return skill;
  return false;
});
---

<Layout
  title="RavexCode | Typescript Junior Developer"
  description="RavexCode is a Typescript Junior developer building web apps, APIs and AI-powered features from real projects."
  canonical="https://ravexcode.com/"
>
  <div class="w-full flex flex-col items-center justify-start">
    <section class="w-full flex flex-col p-5 sm:p-10 mt-8 sm:mt-10 mb-16 sm:mb-20 animate-fade-in-up animate-duration-300">
      <p class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-wide animate-blurred-fade-in select-none animate-duration-700">
        Hi, i'm <span class="text-sky-600">RavexCode</span> <br />a{" "}
        <span class="text-sky-600"> Typescript Junior developer </span>
      </p>
    </section>

    <p
      class="text-3xl sm:text-4xl lg:text-5xl font-medium animate-fade-in-up animate-delay-200 animate-duration-700"
      id="about"
    >
      About me
    </p>
    <p class="tracking-wide animate-fade-in-up animate-delay-200 animate-duration-700 mt-5 mb-20 text-neutral-300 px-10">
      I'm a TypeScript developer who enjoys building practical web applications
      that solve real problems. I work with tools like Next.js, React, and
      PostgreSQL to create everything from workflow platforms and online
      catalogs to AI-powered products. I’m always learning, refining my craft,
      and looking for thoughtful ways to make software useful and easy to use.
    </p>

    <p
      class="text-3xl sm:text-4xl lg:text-5xl font-medium animate-fade-in-up animate-delay-200 animate-duration-700"
      id="projects"
    >
      Projects
    </p>

    <div class="mt-10 sm:mt-15 flex flex-col gap-10 px-5">
      {projects.map((pj) => (
        <Project
          name={pj.name}
          description={pj.description}
          logo_url={pj.logo_url}
          repo={pj.repo}
          deploy={pj.deploy}
          langs={pj.langs}
          frameworks={pj.frameworks}
          apps={pj.apps}
        />
      ))}
    </div>

    <p
      class="text-3xl sm:text-4xl lg:text-5xl font-medium animate-fade-in-up animate-delay-200 animate-duration-700 mt-20 sm:mt-30"
      id="skills"
    >
      Skills
    </p>

    <div class="flex flex-col gap-10 px-5 sm:px-10 justify-center items-start mx-auto mt-10">
      <p class="text-xl font-medium tracking-wides animate-fade-in-up animate-delay-200 animate-duration-700 w-full text-center">
        Languages
      </p>

      <div class="flex flex-wrap gap-5 px-5 sm:px-10 justify-center items-start mx-auto">
        {langs.map((lang) => (
          <div class="flex flex-col justify-center items-center gap-2 animate-fade-in-up animate-delay-200 animate-duration-700 w-25">
            <img src={lang.img} alt={lang.name} class="w-12 h-12" />

            <p>{lang.name}</p>
          </div>
        ))}
      </div>

      <p class="text-xl font-medium tracking-wides animate-fade-in-up animate-delay-200 animate-duration-700 w-full text-center mt-10">
        Frameworks
      </p>

      <div class="flex flex-wrap gap-5 px-5 sm:px-10 justify-center items-start mx-auto">
        {frameworks.map((framework) => (
          <div class="flex flex-col justify-center items-center gap-2 animate-fade-in-up animate-delay-200 animate-duration-700 w-25">
            <img src={framework.img} alt={framework.name} class="w-12 h-12" />

            <p>{framework.name}</p>
          </div>
        ))}
      </div>

      <p class="text-xl font-medium tracking-wides animate-fade-in-up animate-delay-200 animate-duration-700 w-full text-center mt-10">
        Applications
      </p>

      <div class="flex flex-wrap gap-5 px-5 sm:px-10 justify-center items-start mx-auto">
        {apps.map((app) => (
          <div class="flex flex-col justify-center items-center gap-2 animate-fade-in-up animate-delay-200 animate-duration-700 w-25">
            <img src={app.img} alt={app.name} class="w-12 h-12" />

            <p>{app.name}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
