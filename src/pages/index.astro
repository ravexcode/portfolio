---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import { projects } from "../content/projects";
import { skills } from '../content/skills';

const pageTitle = 'RavexCode - Desarrollador Backend Especializado en REST APIs';
const pageDescription = 'Soy RavexCode, un desarrollador backend apasionado por crear REST APIs robustas y escalables. Explora mis proyectos y habilidades en programación.';
---

<Layout
	title={pageTitle}
	description={pageDescription}
	type="website"
	classes="grid grid-rows-[auto_1fr_auto]"
>
  <Header />

  <main>

    <section
    class="flex flex-col justify-center items-start py-10 px-6 md:px-16 md:py-16">

      <h1
      class="text-3xl sm:text-4xl md:text-5xl font-light traking-widest">
        <span data-i18n="hero.greeting">Hola, soy RavexCode</span> <br>
        <span data-i18n="hero.subtitle">un programador enfocado en</span> <span class="text-blue-600 font-normal" data-i18n="hero.specialization">backend</span> 
      </h1>

      <p
      class="font-light text-sm md:text-lg opacity-80 py-2 w-full" data-i18n="hero.description">
        Conocimientos en servicios hechos para Rest APIs.
      </p>

      <div
      class="flex max-w-xs justify-evenly items-center text-center text-sm">
        <a
        href="#contacto"
        class="border border-blue-600 bg-blue-600 w-30 mr-3 py-1.5 rounded-md duration-300 hover:brightness-80" data-i18n="hero.contactBtn">
          Contacto
        </a>
        <a
        href="#proyectos"
        class="border border-neutral-200 w-30 py-1.5 rounded-md duration-300 hover:bg-neutral-200 hover:text-black" data-i18n="hero.moreBtn">
          Ver más
        </a>
      </div>
    </section>

    <section
    id="acerca-de"
    class="py-10 mt-5 w-full flex flex-col justify-center items-center px-10 md:px-20 gap-5 h-max">
      <span
      class="border-2 border-blue-900 bg-blue-950 px-8 py-2 text-sm rounded-full cursor-default mn-10" data-i18n="about.title">
        Sobre mí
      </span>

      <div
      class="grid grid-cols-1 lg:grid-cols-3 w-full gap-5 h-max">
        <article
        class="flex flex-col gap-1 items-center justify-start bg-neutral-900 w-full rounded-xl px-10 py-5">
          <p
          class="text-lg font-medium tracking-wide" data-i18n="about.knowledge.title">
            Conocimientos
          </p>
          <p
          class="font-light" data-i18n="about.knowledge.description">
            Conozco varias tecnologías, pero solo he integrado a la sección skills mis habilidades mejor dominadas. Mi curva de aprendizaje suele estar dentro del promedio, a menos que conozca una tecnología previa que esté relacionada directamente.
          </p>
        </article>
        <article
        class="flex flex-col gap-1 items-center justify-start bg-neutral-900 w-full rounded-xl px-10 py-5">
          <p
          class="text-lg font-medium tracking-wide" data-i18n="about.focus.title">
            Focos
          </p>
          <p
          class="font-light" data-i18n="about.focus.description">
            Suelo estar enfocado en Backend, APIs y Bases de datos. Pero también he manejado frontend, ya sea HTML puro, React o hasta SSR. Suelo ser versatil con mis campos de trabajo, y me puedo adaptar con la debida guía y rutas de aprendizaje
          </p>
        </article>
        <article
        class="flex flex-col gap-1 items-center justify-start bg-neutral-900 w-full rounded-xl px-10 py-5">
          <p
          class="text-lg font-medium tracking-wide" data-i18n="about.teamwork.title">
            Trabajo en equipo
          </p>
          <p
          class="font-light" data-i18n="about.teamwork.description">
            Suelo trabajar bien solo, pero el trabajar en equipo es en lo que suelo trabajar mejor. Debido a que me guío mucho con las instrucciones brindadas dentro del sprint.
          </p>
        </article>
      </div>
    </section>

    <section
    id="proyectos"
    class="py-10 w-full flex flex-col justify-center items-center px-10 md:px-20 gap-5">
      <span
      class="border-2 border-blue-900 bg-blue-950 px-8 py-2 text-sm rounded-full cursor-default mb-10" data-i18n="projects.title">
        Proyectos
      </span>

      {
        projects.map(project => 
        <article class="w-full flex flex-col sm:flex-row bg-neutral-900/40 p-6 rounded-2xl border border-neutral-800/50 shadow-lg backdrop-blur-sm gap-6 transition duration-300 hover:bg-neutral-900/60 hover:border-neutral-700">
          
          <img
            src={project.image}
            alt={`Logo del proyecto ${project.title}`}
            class="aspect-square w-24 h-24 sm:w-32 sm:h-32 object-cover rounded-xl shadow-sm bg-neutral-800/50"
          />

          <div class="flex flex-col flex-1 gap-3 justify-center">
            <div class="flex items-center gap-3">
              {project.repository ? (
                <a 
                  href={project.repository} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-sm text-neutral-400 hover:text-white transition-colors" data-i18n="projects.github"
                >
                  Github
                </a>
              ) : (
                <span class="flex items-center gap-1 text-xs font-medium text-neutral-500 bg-neutral-800/30 px-2.5 py-1 rounded-md border border-neutral-800/50 select-none cursor-not-allowed" title="Repositorio Privado" data-i18n="projects.privateRepo">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                  Repositorio privado
                </span>
              )}

              {project.displayed_at ? (
                <a 
                  href={project.displayed_at} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-sm text-neutral-300 hover:text-white font-medium transition-colors" data-i18n="projects.viewProject"
                >
                  Ver proyecto
                </a>
              ) : (
                <span class="text-xs font-medium text-neutral-500 bg-neutral-800/30 px-2.5 py-1 rounded-md border border-neutral-800/50 select-none cursor-not-allowed" data-i18n="projects.notDeployed">
                  No desplegado
                </span>
              )}
            </div>

            <p class="text-sm text-neutral-400 leading-relaxed max-w-3xl">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-2 mt-2">
              {project.languajes.map((lang) => (
                <span class="px-3 py-1 text-xs font-medium bg-neutral-800/60 text-neutral-300 rounded-full border border-neutral-700/50">
                  {lang}
                </span>
              ))}
              
              {project.frameworks.map((fw) => (
                <span class="px-3 py-1 text-xs font-medium bg-blue-900/10 text-blue-300 rounded-full border border-blue-800/30">
                  {fw}
                </span>
              ))}
              
              {project.applications.map((app) => (
                <span class="px-3 py-1 text-xs font-medium bg-emerald-900/10 text-emerald-300 rounded-full border border-emerald-800/30">
                  {app}
                </span>
              ))}
            </div>
            
          </div>
        </article>
        )
      }
    </section>

    <section
    class="py-10 mt-5 w-full flex flex-col justify-center items-center px-10 md:px-20 gap-10"
    id="skills">
      <span
      class="border-2 border-blue-900 bg-blue-950 px-8 py-2 text-sm rounded-full cursor-default text-center" data-i18n="skills.title">
        Skills
      </span>

      <article
      class="grid grid-cols-3 md:grid-cols-6 lg:flex lg:flex-wrap items-start justify-center gap-5">
        {
          skills.map(skill =>
            (
              <div
              class="flex flex-col gap-2 items-center justify-center text-center text-lg cursor-default">
                <img
                src={skill.img}
                alt={skill.name}
                class={"aspect-square block w-10" + (skill.name.toLowerCase() === "express js" ? " bg-zinc-50 rounded-full p-1" : " rounded-lg")} />

                <p
                class="font-light tracking-wide">
                  { skill.name }
                </p>

                {
                  skill.isFramework && (
                    <span
                    class="px-3 py-1 rounded-full text-xs border border-blue-600 bg-blue-800/50">
                      Framework
                    </span>
                  )
                }

                {
                  skill.isApplication && (
                    <span
                    class="px-3 py-1 rounded-full text-xs border border-purple-600 bg-purple-800/50">
                      Application
                    </span>
                  )
                }
              </div>
            )
          )
        }
      </article>
    </section>

    <section
    class="py-10 mt-5 w-full flex flex-col justify-center items-center px-10 gap-10">
      <span
      class="border-2 border-blue-900 bg-blue-950 px-8 py-2 text-sm rounded-full cursor-default text-center"
      id="contacto" data-i18n="contact.title">
        Mi contacto
      </span>
      
      <form
      method="POST"
      id="contact-form"
      class="px-8 w-full md:max-w-sm py-4 rounded-lg bg-gray-950 border border-sky-900/50">
        <h2 class="text-lg tracking-wide text-center mb-5" data-i18n="contact.subtitle">
          Sube de nivel tus APIs
        </h2>

        <label class="text-sm font-light tracking-wide" data-i18n="contact.emailLabel">
          Ingresa tu correo de contacto
        </label>
        <input
        type="email"
        name="email"
        required
        data-i18n-attr="placeholder:contact.emailPlaceholder"
        placeholder="contacto@dominio.com"
        class="w-full rounded-lg px-4 py-2 border border-transparent bg-gray-900/50 duration-300 focus:border-blue-600 outline-none mt-2 mb-4"/>

        <label class="text-sm font-light tracking-wide" data-i18n="contact.subjectLabel">
          ¿En qué estará enfocado tu proyecto?
        </label>
        <input
        type="text"
        name="subject"
        required
        data-i18n-attr="placeholder:contact.subjectPlaceholder"
        placeholder="Busco una API Rest para..."
        class="w-full rounded-lg border border-transparent bg-gray-900/50 px-4 py-2 duration-300 focus:border-blue-600 outline-none mt-2 mb-4" />

        <label class="text-sm font-light tracking-wide" data-i18n="contact.messageLabel">
          Describe tu proyecto
        </label>
        <textarea
        name="message"
        required
        data-i18n-attr="placeholder:contact.messagePlaceholder"
        placeholder="Una API CRUD para mi proyecto freelance..."
        class="w-full rounded-lg border border-transparent bg-gray-900/50 px-4 py-2 duration-300 focus:border-blue-600 outline-none mt-2 mb-4 min-h-50"></textarea>

        <button
        type="submit"
        class="w-full rounded-full p-2 bg-blue-600 mt-5 cursor-pointer duration-300 hover:bg-blue-800" data-i18n="contact.submitButton">
          Contactarme
        </button>
      </form>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;

  if(form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);

      const body = {
        subject: formData.get("subject"),
        email: formData.get("email"),
        message: formData.get("message"),
      };

      const res = await fetch("/api/contact", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(body),
      });

      const data = await res.json();

      console.log(data);

      if (res.ok) {
        formData.delete("subject");
        formData.delete("email");
        formData.delete("message");
      }
    });
  }
</script>