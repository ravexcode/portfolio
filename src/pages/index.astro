---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import { projects } from "../content/projects";
import { skills } from '../content/skills';

const pageTitle = 'RavexCode - Desarrollador Backend Especializado en REST APIs';
const pageDescription = 'Soy RavexCode, un desarrollador backend apasionado por crear REST APIs robustas y escalables. Explora mis proyectos y habilidades en programación.';
---

<Layout
	title={pageTitle}
	description={pageDescription}
	type="website"
	classes="grid grid-rows-[auto_1fr_auto]"
>
  <Header />

  <main>

    <section
    class="flex flex-col justify-center items-start py-10 px-6 md:px-16 md:py-16">

      <h1
      class="text-3xl sm:text-4xl md:text-5xl font-light traking-widest"> Hola, soy RavexCode <br>
      un programador enfocado en <span class="text-blue-600 font-normal">backend</span> </h1>

      <p
      class="font-light text-sm md:text-lg opacity-80 py-2 w-full">
        Conocimientos en servicios hechos para Rest APIs.
      </p>

      <div
      class="flex max-w-xs justify-evenly items-center text-center text-sm">
        <a
        href="#contacto"
        class="border border-blue-600 bg-blue-600 px-6 mr-3 py-2 rounded-md duration-300 hover:brightness-80">
          Contacto
        </a>
        <a
        href="#proyectos"
        class="border-1 border-neutral-200 px-6 py-2 rounded-md duration-300 hover:bg-neutral-200 hover:text-black">
          Ver más
        </a>
      </div>
    </section>

    <section
    id="proyectos"
    class="py-10 mt-5 w-full flex flex-col justify-center items-center px-10 md:px-20 gap-5">
      <span
      class="border-2 border-blue-900 bg-blue-950 px-8 py-2 text-sm rounded-full cursor-default mb-10"
      id="proyectos">
        Proyectos
      </span>

      {
        projects.map(project => 
        <article class="w-full flex flex-col sm:flex-row bg-neutral-900/40 p-6 rounded-2xl border border-neutral-800/50 shadow-lg backdrop-blur-sm gap-6 transition duration-300 hover:bg-neutral-900/60 hover:border-neutral-700">
          
          <img
            src={project.image}
            alt={`Logo del proyecto ${project.title}`}
            class="aspect-square w-24 h-24 sm:w-32 sm:h-32 object-cover rounded-xl shadow-sm bg-neutral-800/50"
          />

          <div class="flex flex-col flex-1 gap-3 justify-center">
            <div class="flex items-center gap-3">
              {project.repository ? (
                <a 
                  href={project.repository} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-sm text-neutral-400 hover:text-white transition-colors"
                >
                  Github
                </a>
              ) : (
                <span class="flex items-center gap-1 text-xs font-medium text-neutral-500 bg-neutral-800/30 px-2.5 py-1 rounded-md border border-neutral-800/50 select-none cursor-not-allowed" title="Repositorio Privado" >
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 opacity-70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                  </svg>
                  Repositorio privado
                </span>
              )}

              {project.displayed_at ? (
                <a 
                  href={project.displayed_at} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="text-sm text-neutral-300 hover:text-white font-medium transition-colors"
                >
                  Ver proyecto
                </a>
              ) : (
                <span class="text-xs font-medium text-neutral-500 bg-neutral-800/30 px-2.5 py-1 rounded-md border border-neutral-800/50 select-none cursor-not-allowed">
                  No desplegado
                </span>
              )}
            </div>

            <p class="text-sm text-neutral-400 leading-relaxed max-w-3xl">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-2 mt-2">
              {project.languajes.map((lang) => (
                <span class="px-3 py-1 text-xs font-medium bg-neutral-800/60 text-neutral-300 rounded-full border border-neutral-700/50">
                  {lang}
                </span>
              ))}
              
              {project.frameworks.map((fw) => (
                <span class="px-3 py-1 text-xs font-medium bg-blue-900/10 text-blue-300 rounded-full border border-blue-800/30">
                  {fw}
                </span>
              ))}
              
              {project.applications.map((app) => (
                <span class="px-3 py-1 text-xs font-medium bg-emerald-900/10 text-emerald-300 rounded-full border border-emerald-800/30">
                  {app}
                </span>
              ))}
            </div>
            
          </div>
        </article>
        )
      }
    </section>

    <section
    class="py-10 mt-5 w-full flex flex-col justify-center items-center px-10 md:px-20 gap-10">
      <span
      class="border-2 border-blue-900 bg-blue-950 px-8 py-2 text-sm rounded-full cursor-default text-center"
      id="skills">
        Skills
      </span>

      <article
      class="grid grid-cols-3 md:grid-cols-6 lg:flex lg:flex-wrap items-start justify-center gap-5">
        {
          skills.map(skill =>
            (
              <div
              class="flex flex-col gap-2 items-center justify-center text-center text-lg cursor-default">
                <img
                src={skill.img}
                alt={skill.name}
                class="aspect-square block w-10 rounded-lg" />

                <p
                class="font-light tracking-wide">
                  { skill.name }
                </p>

                {
                  skill.isFramework && (
                    <span
                    class="px-3 py-1 rounded-full text-xs border border-blue-600 bg-blue-800/50">
                      Framework
                    </span>
                  )
                }

                {
                  skill.isApplication && (
                    <span
                    class="px-3 py-1 rounded-full text-xs border border-purple-600 bg-purple-800/50">
                      Application
                    </span>
                  )
                }
              </div>
            )
          )
        }
      </article>
    </section>

    <section
    class="py-10 mt-5 w-full flex flex-col justify-center items-center px-10 md:px-20 gap-10">
      <span
      class="border-2 border-blue-900 bg-blue-950 px-8 py-2 text-sm rounded-full cursor-default text-center"
      id="contacto">
        Mi contacto
      </span>
      
      <form
      method="POST"
      action="https://formspree.io/f/xnjwnlkv"
      class="px-8 w-sm max-w-80 md:max-w-sm py-4 rounded-lg bg-gray-950 border-2 border-blue-900">
        <h2 class="text-lg tracking-wide text-center mb-5">
          Sube de nivel tus APIs
        </h2>

        <label class="text-sm font-light tracking-wide">
          Ingresa tu correo de contacto
        </label>
        <input
        type="email"
        name="email"
        required
        placeholder="contacto@dominio.com"
        class="w-full rounded-lg border-2 px-4 py-2 border-neutral-600 duration-300 focus:border-blue-600 outline-none mt-2 mb-4"/>

        <label class="text-sm font-light tracking-wide">
          ¿En qué estará enfocado tu proyecto?
        </label>
        <input
        type="text"
        name="subject"
        required
        placeholder="Busco una API Rest para..."
        class="w-full rounded-lg border-2 px-4 py-2 border-neutral-600 duration-300 focus:border-blue-600 outline-none mt-2 mb-4" />

        <label class="text-sm font-light tracking-wide">
          Describe tu proyecto
        </label>
        <textarea
        name="message"
        required
        placeholder="Una API CRUD para mi proyecto freelance..."
        class="w-full rounded-lg border-2 px-4 py-2 border-neutral-600 duration-300 focus:border-blue-600 outline-none mt-2 mb-4 min-h-50"></textarea>

        <button
        type="submit"
        class="w-full rounded-full p-2 bg-blue-600 mt-5 cursor-pointer duration-300 hover:bg-blue-800" >
          Contactarme
        </button>

        <input type="hidden" name="_redirect" value="https://ravexcode.com/" />
      </form>
    </section>

  </main>

  <Footer />
</Layout>
