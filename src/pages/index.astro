---
import Layout from '../layouts/Layout.astro';
import Card from '../components/ui/card.astro';
import Project from '../components/ui/project.astro';

import { projects } from '../content/projects';
import { skills } from '../content/skills';
---

<Layout
	title="RavexCode | Junior Full-Stack & AI Engineer"
	description="RavexCode is a junior full-stack and AI engineer building web apps, APIs and AI-powered features from real projects."
	canonical="https://ravexcode.com/"
>
	<div
	class="w-full flex flex-col items-center justify-start">
		<section
		class="w-full flex flex-col p-5 sm:p-10 mt-8 sm:mt-10 mb-16 sm:mb-20 animate-fade-in-up animate-duration-300">
			<p
			class="text-3xl sm:text-4xl lg:text-5xl font-medium tracking-wide animate-blurred-fade-in select-none animate-duration-500">
				Hi, i'm <span class="text-sky-600">RavexCode</span> <br>
				a <span class="text-sky-600">Junior FullStack & AI</span> engineer
			</p>
			<h1
			class="animate-blurred-fade-in mt-2 text-base sm:text-lg font-extralight animate-duration-500">
				Building with Rest APIs, React and AI tools. English level B2
			</h1>
		</section>
		
		<p
		class="text-3xl sm:text-4xl lg:text-5xl font-medium animate-fade-in-up animate-delay-200 animate-duration-700"
		id="about">
			About me
		</p>

		<section
		class="flex flex-col lg:flex-row gap-6 justify-center items-stretch mt-10 mb-16 sm:mb-30 px-5">
			<Card
			title='Knowledge'
			content="I'm a junior developer, so my stack comes from real work: every skill I list comes from a project I've actually built. That keeps me honest about what I truly master, and open about what I still need to learn." />
			<Card
			title='Focus'
			content="Full-stack with an AI edge: REST APIs, databases and backend logic, plus AI-powered features such as intelligent workflows and assistants. I also handle frontend, from pure HTML to React and SSR." />
			<Card
			title='Teamwork'
			content="My English is B2, so I can communicate clearly in international teams. I work well alone, but I work best in a team, following the instructions and guidance within each sprint." />
		</section>

		<p
		class="text-3xl sm:text-4xl lg:text-5xl font-medium animate-fade-in-up animate-delay-200 animate-duration-700"
		id="projects">
			Projects
		</p>

		<div
		class="mt-10 sm:mt-15 flex flex-col gap-10 px-5">
			{
				projects.map(pj =>
					<Project
					name={pj.name}
					description={pj.description}
					logo_url={pj.logo_url}
					repo={pj.repo}
					deploy={pj.deploy}
					langs={pj.langs}
					frameworks={pj.frameworks}
					apps={pj.apps}
					/>
				)
			}
		</div>

		<p
		class="text-3xl sm:text-4xl lg:text-5xl font-medium animate-fade-in-up animate-delay-200 animate-duration-700 mt-20 sm:mt-30"
		id="skills">
			Skills
		</p>

		<div
		class="flex flex-wrap gap-5 sm:gap-10 px-5 sm:px-10 justify-center items-start mx-auto my-10 sm:my-20">
			{
				skills.map(skill =>
					<div
					class="w-20 sm:w-25 h-24 sm:h-30 flex flex-col items-center justify-start gap-2 font-medium">
						<img
						src={skill.img}
						alt="App logo"
						class="w-8 sm:w-10 aspect-square block" />

						{ skill.name }
						
						{
							skill.isApplication ?
								<span
								class="bg-violet-900 border border-violet-600 rounded-full text-center p-1 text-xs w-15">
									App
								</span>
								:
								skill.isFramework && 
								<span
								class="bg-blue-900 border border-blue-600 rounded-full text-center p-1 text-xs w-20 sm:w-25">
									Framework
								</span>
						}
					</div>
				)
			}
		</div>

		<p
		class="text-3xl sm:text-4xl lg:text-5xl font-medium animate-fade-in-up animate-delay-200 animate-duration-700 mt-20 sm:mt-30"
		id="hire">
			Hire me
		</p>

		<section
		class="w-full max-w-200 flex flex-col items-center justify-center gap-8 p-5 sm:p-10 my-10 sm:my-20 text-center">
			<p
			class="text-lg text-neutral-400 font-light max-w-150">
				Have a project, a team or a sprint that needs a junior full-stack and AI engineer? I'm available. Write me an e-mail and I'll get back to you.
			</p>

			<a
			href="mailto:rafamartz2007@gmail.com"
			class="p-3 px-8 rounded-md bg-blue-700 text-zinc-50 font-medium hover:scale-105 hover:bg-blue-600 duration-300">
				rafamartz2007@gmail.com
			</a>

			<div
			class="flex flex-wrap items-center justify-center gap-5 text-sm">
				<a
				href="https://github.com/ravexcode"
				class="flex items-center justify-center gap-2 p-2 px-5 rounded-md bg-neutral-900 border border-neutral-700 text-zinc-50 hover:border-blue-600 hover:scale-105 duration-300">
					<img
					src="https://github.com/favicon.ico"
					alt="Github logo"
					class="invert aspect-square rounded-full block w-4">
					GitHub
				</a>
				<a
				href="https://x.com/rafamartz2007"
				class="flex items-center justify-center gap-2 p-2 px-5 rounded-md bg-neutral-900 border border-neutral-700 text-zinc-50 hover:border-blue-600 hover:scale-105 duration-300">
					X (Twitter)
				</a>
				<a
				href="https://www.linkedin.com/in/jose-mart%C3%ADnez-b6883b407/"
				class="flex items-center justify-center gap-2 p-2 px-5 rounded-md bg-neutral-900 border border-neutral-700 text-zinc-50 hover:border-blue-600 hover:scale-105 duration-300">
					LinkedIn
				</a>
			</div>
		</section>
	</div>
</Layout>
