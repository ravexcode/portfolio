---
interface Props {
  title: string;
  text: string;
}

const { title = "", text = "" } = Astro.props;
---

<div class="rounded-sm bg-neutral-900/60 border border-neutral-800 p-5">
  <p class="font-medium text-zinc-50 text-sm">
    {title}
  </p>
  <p class="mt-2 text-sm text-neutral-400 font-light">
    {text}
  </p>
</div>
