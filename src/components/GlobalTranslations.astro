  function getTranslation(lang, key) {

    const keys = key.split('.');
    let value = lang === "en" ? (JSON.parse(translations)).en : (JSON.parse(translations)).es
    
    for (const k of keys) {
      value = value?.[k];
    }
    
    return value || key;
  }

  function updatePageLanguage(lang) {
    document.querySelectorAll('[data-i18n]').forEach((element) => {
      const key = element.getAttribute('data-i18n');
      const text = getTranslation(lang, key);
      
      if (text && typeof text === 'string') {
        element.textContent = text;
      }
    });

    document.querySelectorAll('[data-i18n-attr]').forEach((element) => {
      const attrKey = element.getAttribute('data-i18n-attr');
      const [attr, key] = attrKey.split(':');
      const text = getTranslation(lang, key);
      
      if (text && typeof text === 'string') {
        element.setAttribute(attr, text);
      }
    });
  }

  const currentLang = localStorage.getItem('language') || 'es';
  updatePageLanguage(currentLang);

  window.addEventListener('languageChange', (e) => {
    updatePageLanguage(e.detail.language);
  });
</script>
